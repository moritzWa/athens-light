{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athens-light",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "athens-light.app", "custom_domain": true },
    { "pattern": "www.athens-light.app", "custom_domain": true }
  ]
}
